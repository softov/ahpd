{
  "name": "@ahpd/tunnel-devtunnel",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "Microsoft Dev Tunnels for ahpd. Reach the daemon from anywhere, VS Code included.",
  "keywords": [
    "ahp",
    "ahpd",
    "agent-host-protocol",
    "ahpio",
    "plugin",
    "tunnel",
    "devtunnel",
    "dev-tunnels",
    "vscode",
    "remote-access"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/tunnel-devtunnel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/tunnel-devtunnel"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/tunnel-devtunnel/test"
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "^1.3.61",
    "@microsoft/dev-tunnels-contracts": "^1.3.61",
    "@microsoft/dev-tunnels-management": "^1.3.61",
    "@microsoft/dev-tunnels-ssh": "^3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "^3.12.42"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Dev Tunnel",
    "description": "Reach the daemon from anywhere through a Microsoft Dev Tunnel.",
    "categories": [],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "adapters": ["devtunnel"],
      "closers": ["the relay hosts this plugin opened"],
      "tunnelKinds": ["devtunnel"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "connector": { "type": "string", "minLength": 1, "description": "Dev Tunnel connector for this host's tunnel. No tunnel opens until one is set." },
        "name": { "type": "string", "description": "Tunnel name shown in clients. Defaults to this machine's hostname." },
        "keep": { "type": "boolean", "description": "Keep the tunnel after the daemon stops. On by default." },
        "anonymous": { "type": "boolean", "description": "Let people not signed in to this account reach the tunnel. Off by default." },
        "allowAccountChange": { "type": "boolean", "description": "Let a new sign-in replace the connector's GitHub account. Off by default." }
      }
    }
  }
}
