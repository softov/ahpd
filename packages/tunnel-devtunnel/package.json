{
  "name": "@ahpd/tunnel-devtunnel",
  "version": "0.14.0",
  "type": "module",
  "description": "A Dev Tunnel plugin for ahpd: forwards the bound port through a Microsoft Dev Tunnel so VS Code can find and reach the daemon from anywhere",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "tunnel",
    "devtunnel",
    "dev-tunnels",
    "vscode"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/tunnel-devtunnel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/tunnel-devtunnel"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/tunnel-devtunnel/test"
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "^1.3.61",
    "@microsoft/dev-tunnels-contracts": "^1.3.61",
    "@microsoft/dev-tunnels-management": "^1.3.61",
    "@microsoft/dev-tunnels-ssh": "^3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "^3.12.42"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Dev Tunnel",
    "description": "A Dev Tunnel that forwards the bound port, so a client reaches the daemon from anywhere.",
    "categories": [],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "adapters": ["devtunnel"],
      "closers": ["the relay hosts this plugin opened"],
      "tunnelKinds": ["devtunnel"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "connector": { "type": "string", "minLength": 1, "description": "The devtunnel connector this host's own tunnel uses. Absent, no tunnel is opened until one is set." },
        "name": { "type": "string", "description": "What a Dev Tunnel this plugin makes is called in a client's list. This machine's hostname by default." },
        "keep": { "type": "boolean", "description": "Whether the tunnel outlives the daemon. true by default." },
        "anonymous": { "type": "boolean", "description": "Whether somebody not signed in to this account may reach it. false by default." },
        "allowAccountChange": { "type": "boolean", "description": "Whether a second sign-in may replace a connector's GitHub account. false by default." }
      }
    }
  }
}
