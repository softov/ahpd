{
  "name": "@ahpd/computer",
  "version": "0.8.0",
  "type": "module",
  "description": "Disposable Docker machines for the ahpd daemon: a computer: resource provider and the tools that make, use and release one",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "resource",
    "computer",
    "docker",
    "container",
    "sandbox"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/computer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/computer"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/computer/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.8"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Computer",
    "options": {
      "runtime": { "required": false },
      "command": { "required": false },
      "args": { "required": false },
      "env": { "required": false },
      "image": { "required": false },
      "mounts": { "required": false },
      "profiles": { "required": false },
      "cpus": { "required": false },
      "memory": { "required": false },
      "max": { "required": false },
      "label": { "required": false },
      "devcontainer": { "required": false }
    }
  }
}
