{
  "http.proxy": "http://proxy.example.test:8080",
  "http.proxyKerberosServicePrincipal": "HTTP/proxy.example.test",
  "http.noProxy": [],
  "disableRepoInfoTelemetry": false,
  "telemetryLevel": "all",
  "editTelemetryEnabled": true,
  "sessionSyncEnabled": false,
  "codexAgentEnabled": false,
  "terminalAutoApproveEnabled": true,
  "globalAutoApproveEnabled": false,
  "autoApprovePolicyRestricted": false,
  "workspaceTrust": { "enabled": true, "trustedUris": ["file:///home/example/project"] },
  "autoReplyEnabled": false,
  "systemProxyEnabled": true,
  "githubMcpServerEnabled": true,
  "mcpToolRoutingEnabled": false,
  "mcpConnectorsEnabled": false,
  "markdownPlanRichLinksEnabled": false,
  "workspaceSnapshotEnabled": false,
  "agentOrchestrationLimits": "on",
  "artifactTools": false,
  "canvasesEnabled": false,
  "autoAttachPullRequests": true,
  "overlapProviderPreparation": false,
  "migrateLegacyCopilotCliEnabled": false,
  "sessionCatalogEnabled": true,
  "showExternalSessions": "none",
  "autoArchiveMergedSessionsAfterDays": 0,
  "autoDeleteArchivedMergedSessionsAfterDays": 0,
  "copilotMultiRootEnabled": false,
  "claudeMultiRootEnabled": false,
  "codexMultiRootEnabled": false,
  "editAutoApprovePatterns": {
    "**/*": true,
    "**/.git/**": false,
    "**/{package.json,server.xml,build.rs,web.config,.gitattributes,.env,Cargo.toml}": false,
    "**/{.npmrc,.yarnrc,.yarnrc.yml,.pnpmfile.js,.pnpmfile.cjs,.pnpmfile.mjs,pnpm-workspace.yaml}": false,
    "**/*.{code-workspace,csproj,fsproj,vbproj,vcxproj,proj,targets,props,gradle,gradle.kts}": false,
    "**/gradle.properties": false,
    "**/ruby_lsp/*/addon": false,
    "**/*.lock": false,
    "**/*-lock.{yaml,json}": false,
    "**/.mcp.json": false,
    "**/.npmrc": false,
    "**/.vscode/*.json": false,
    "**/.github/agents/**": false,
    "**/.github/hooks/**": false,
    "**/.claude/agents/**": false,
    "**/.claude/settings.json": false,
    "**/.claude/settings.local.json": false,
    "**/.codex/agents/**": false,
    "**/.codex/config.toml": false,
    "**/.codex/hooks.json": false
  },
  "terminalAutoApproveRules": {},
  "agentMerge.enabled": false,
  "agentMerge.addressReviews": true,
  "agentMerge.fixCI": true,
  "agentMerge.resolveConflicts": true,
  "agentMerge.mergePullRequest": "never",
  "agentMerge.mergeMethod": "auto",
  "agentMerge.replyAttribution": true,
  "automationsEnabled": false,
  "automationRunTimeoutMinutes": 30,
  "activeAgentTitleGeneration": true,
  "artifactToolsCompactPrompts": true,
  "deferredTitleGeneration": true,
  "vscode.automationMigration": true
}
