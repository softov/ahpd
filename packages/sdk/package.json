{
  "name": "@ahpd/sdk",
  "version": "0.10.0",
  "type": "module",
  "description": "A server library for the Agent Host Protocol. No agent inside, you pass one in",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "websocket",
    "server",
    "host",
    "daemon"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && node tools/schema.mjs && vitest run packages/sdk/test"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "optionalDependencies": {
    "ws": "^8.18.0"
  }
}
