{
  "name": "@ahpd/server",
  "version": "0.15.0-rc.2",
  "type": "module",
  "description": "The ahpd daemon: an Agent Host Protocol server on Node, Bun or Deno, with agents loaded as plugins",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "websocket",
    "cli",
    "command-line",
    "daemon",
    "plugin"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "homepage": "https://github.com/ahpio/ahpd/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahpio/ahpd.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/ahpio/ahpd/issues"
  },
  "bin": {
    "ahpd": "./dist/main.js"
  },
  "files": [
    "dist",
    "icons",
    "shellintegration",
    "README.md"
  ],
  "engines": {
