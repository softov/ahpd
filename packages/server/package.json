    "test": "cd ../.. && vitest run packages/server/test"
  },
  "dependencies": {
    "@ahpd/sdk": "workspace:^",
    "@cofold/commands": "^0.3.0",
    "@cofold/config": "^0.3.1",
    "@cofold/remote": "^0.5.0",
    "@cofold/terminal": "^0.4.0",
    "@cofold/yaml": "^0.3.0",
    "@microsoft/agent-host-protocol": "^1.0.0",
    "@xterm/headless": "^6.0.0",
    "semver": "^7.8.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0-beta40"
  },
