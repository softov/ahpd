{
  "name": "@ahpd/server",
  "version": "0.8.0",
  "type": "module",
  "description": "The ahpd daemon: an Agent Host Protocol server on Node, Bun or Deno, with agents loaded as plugins",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "websocket",
    "cli",
    "command-line",
    "daemon",
    "plugin"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "bin": {
    "ahpd": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/server/test"
  },
  "dependencies": {
    "@ahpd/sdk": "workspace:^",
    "@cofold/commands": "^0.2.2",
    "@cofold/remote": "^0.4.0",
    "@cofold/terminal": "^0.2.0",
    "@microsoft/agent-host-protocol": "^0.9.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0-beta40"
  },
  "publishConfig": {
    "access": "public"
  }
}
