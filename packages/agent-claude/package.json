{
  "name": "@ahpd/agent-claude",
  "version": "0.8.0",
  "type": "module",
  "description": "Claude Code as an Agent Host Protocol backend: a plugin for the ahpd daemon and an Agent for @ahpd/sdk",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "websocket",
    "claude",
    "claude-code",
    "anthropic",
    "backend",
    "adapter"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/agent-claude#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/agent-claude"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/agent-claude/test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.8",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Claude",
    "options": {
      "paths": {
        "required": false
      },
      "provider": {
        "required": false
      },
      "displayName": {
        "required": false
      },
      "models": {
        "required": false
      },
      "keepCliModels": {
        "required": false
      },
      "computerExecutable": {
        "required": false
      },
      "computerConfigDir": {
        "required": false
      },
      "workerStop": {
        "required": false
      },
      "presets": {
        "required": false
      }
    }
  }
}
