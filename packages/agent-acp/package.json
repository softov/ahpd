{
  "name": "@ahpd/agent-acp",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "An AHP backend over the Agent Client Protocol: any ACP server is one provider instead of one package",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "backend",
    "adapter",
    "acp",
    "agent-client-protocol",
    "copilot",
    "codex",
    "gemini"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/agent-acp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/agent-acp"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/agent-acp/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Agent ACP",
    "description": "Connects any ACP-compatible agent, including Copilot, Codex, Gemini, and custom ACP servers.",
    "categories": ["agent"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "agents": ["*"],
      "engines": ["acp"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "hostTools": { "type": "boolean", "description": "Offer the host's own tools to each session as an MCP server, on by default." },
        "toolsChanged": {
          "type": "string",
          "enum": ["notify", "list"],
          "description": "How each session's agent hears that the tools it listed have moved, over each record's own: notify sends notifications/tools/list_changed down a stream the host holds open, list says nothing and leaves it to the agent's next tools/list. Both serve the current list; defaults to notify."
        }
      }
    }
  }
}
