{
  "name": "@ahpd/agent-acp",
  "version": "0.15.0-rc.3",
  "type": "module",
  "description": "Agent Client Protocol integration for the Agent Host Protocol. Run any ACP agent as an ahpd plugin or use it directly with @ahpd/sdk.",
  "keywords": [
    "ahp",
    "ahpd",
    "agent-host-protocol",
    "ahpio",
    "ai-agent",
    "acp",
    "agent-client-protocol",
    "copilot",
    "codex",
    "gemini",
    "agent-backend",
    "agent-sdk",
    "plugin",
    "adapter"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ahpio/ahpd/tree/main/packages/agent-acp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahpio/ahpd.git",
    "directory": "packages/agent-acp"
  },
  "bugs": {
    "url": "https://github.com/ahpio/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/agent-acp/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Agent ACP",
    "description": "Run any ACP agent, including Copilot, Codex, Gemini and custom ACP servers.",
    "categories": ["agent"],
    "links": [{ "title": "Repository", "url": "https://github.com/ahpio/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "agents": ["*"],
      "engines": ["acp"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "hostTools": { "type": "boolean", "description": "Offer the host's tools to each session as an MCP server. On by default. Each agent can override it." },
        "toolsChanged": {
          "type": "string",
          "enum": ["notify", "list"],
          "description": "How an agent learns that its tool list changed. 'notify' (default) sends notifications/tools/list_changed; 'list' sends nothing and waits for the agent's next tools/list. Each agent can override it."
        }
      }
    }
  }
}
