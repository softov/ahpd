{
  "name": "@ahpd/bot",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "Bots for ahpd. Each bot has its own identity, workspace and sessions.",
  "keywords": [
    "ahp",
    "ahpd",
    "agent-host-protocol",
    "ahpio",
    "ai-agent",
    "plugin",
    "bot",
    "assistant",
    "chatbot"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/bot"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/bot/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@cofold/yaml": "^0.3.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Bot",
    "description": "Create bots with their own identity, workspace and persistent sessions.",
    "categories": ["agent", "channel", "tool"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "agents": ["bot-chat"],
      "channels": ["x-ahpd-bots"],
      "grants": ["bot"],
      "resourceProviders": ["bot"],
      "tools": ["post_message"],
      "bindings": ["*"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "description": "Folder for bot workspaces, one '<root>/<slug>' per bot. Defaults to '~/.bots'. Cannot be inside the configuration folder." },
        "lastChats": { "type": "integer", "minimum": 1, "description": "How many recent chats '{{chats}}' lists in a template. Defaults to 10." },
        "mainTurnPostMessageAbsent": {
          "type": "string",
          "description": "What the bot's chat shows when its work session ends without post_message. 'post' (default) shows the session's last words; 'notice' shows a notice; 'silence' shows nothing; 'postNotice' shows the last words, or the notice when there are none."
        }
      }
    }
  }
}
