{
  "name": "@ahpd/bot",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "Bots for the ahpd daemon: a bot: resource provider, where a bot is a record with a workspace and a session",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "resource",
    "bot",
    "assistant"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/bot"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/bot/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@cofold/yaml": "^0.3.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Bot",
    "description": "Creates conversational bots with individual identities, workspaces, and persistent sessions.",
    "categories": ["agent", "channel", "tool"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "agents": ["bot-chat"],
      "channels": ["x-ahpd-bots"],
      "grants": ["bot"],
      "resourceProviders": ["bot"],
      "tools": ["post_message"],
      "bindings": ["*"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "description": "The folder a bot's own workspace is under, as <root>/<slug>." },
        "lastChats": { "type": "integer", "minimum": 1, "description": "How many chats a template lists for {{chats}}." },
        "mainTurnPostMessageAbsent": {
          "type": "string",
          "description": "What a main turn does when the back session's turn ends without post_message: post (the default), notice, silence or postNotice."
        }
      }
    }
  }
}
