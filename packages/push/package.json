{
  "name": "@ahpd/push",
  "version": "0.15.0-rc.2",
  "type": "module",
  "description": "Push notifications for ahpd. Tells a phone or browser when a session needs you, through Expo or Web Push.",
  "keywords": [
    "ahp",
    "ahpd",
    "agent-host-protocol",
    "ahpio",
    "plugin",
    "push",
    "notifications",
    "expo",
    "web-push",
    "apns",
    "fcm"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ahpio/ahpd/tree/main/packages/push#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahpio/ahpd.git",
    "directory": "packages/push"
  },
  "bugs": {
    "url": "https://github.com/ahpio/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/push/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Push",
    "description": "Send push notifications to your devices when a session needs your attention.",
    "categories": [],
    "links": [{ "title": "Repository", "url": "https://github.com/ahpio/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "resourceProviders": ["push"],
      "closers": ["the receipt reads and the completed notices still to come"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string", "writeOnly": true, "secretAtUse": true, "description": "Expo access token, for projects with push security on. Can be a vault reference, such as {\"$secret\": \"host:expo\"}." },
        "webPushHosts": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["*.push.apple.com", "fcm.googleapis.com", "updates.push.services.mozilla.com", "*.notify.windows.com"],
          "description": "Hosts allowed as a browser's push endpoint. '*.<domain>' matches any host under that domain. Other hosts are refused."
        },
        "contact": {
          "type": "string",
          "description": "mailto: or https: URI sent as the VAPID 'sub' claim, so a push service can reach the operator. Not sent when unset."
        }
      }
    }
  }
}
