{
  "name": "@ahpd/tasks",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "Tasks and plans for the ahpd daemon: one list every agent reads and writes through host tools",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "tasks",
    "plans",
    "kanban"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/tasks"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/tasks/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@cofold/agents": "^0.4.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Tasks",
    "description": "One list of tasks and plans every agent reads and writes.",
    "categories": ["channel", "tool"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "channels": ["x-ahpd-plans"],
      "tools": [
        "plan_create",
        "plan_set",
        "plan_show",
        "plan_list",
        "plan_approve",
        "task_add",
        "task_set",
        "task_list",
        "task_approve",
        "task_review"
      ],
      "plans": ["a session's plan lines"],
      "sessionMeta": ["ahpd.tasks"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "requireApproval": {
          "type": "boolean",
          "description": "Whether an agent may set a task to doing before somebody approved it. Off by default."
        },
        "sweepAfterDays": {
          "type": "integer",
          "minimum": 1,
          "description": "How many days a done or dropped plan is kept. Absent, a finished plan is kept forever."
        }
      }
    }
  }
}
