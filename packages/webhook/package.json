{
  "name": "@ahpd/webhook",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "Webhooks for the ahpd daemon: a URL that talks to a bot by thread or fires an automation, with a secret per endpoint",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "webhook",
    "bot",
    "automation"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/webhook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/webhook"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/webhook/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Webhook",
    "description": "A URL that talks to a bot or fires an automation, with a secret per endpoint.",
    "categories": ["connector"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "routes": ["post /plugins/webhook/:endpoint"],
      "triggerTypes": ["webhook"],
      "adapters": ["webhook"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "syncTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How long a sync call waits for its turn to end, in seconds."
        },
        "maxBodyBytes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The most of a call body this plugin reads, in bytes. A larger body answers 413."
        }
      }
    }
  }
}
