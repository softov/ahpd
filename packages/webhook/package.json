{
  "name": "@ahpd/webhook",
  "version": "0.15.0-rc.3",
  "type": "module",
  "description": "Webhooks for ahpd. A URL that talks to a bot or fires an automation, with its own secret.",
  "keywords": [
    "ahp",
    "ahpd",
    "agent-host-protocol",
    "ahpio",
    "plugin",
    "webhook",
    "bot",
    "automation",
    "integrations"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ahpio/ahpd/tree/main/packages/webhook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahpio/ahpd.git",
    "directory": "packages/webhook"
  },
  "bugs": {
    "url": "https://github.com/ahpio/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "icon-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/webhook/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*",
    "@microsoft/agent-host-protocol": "^1.0.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Webhook",
    "description": "Give a bot or an automation its own URL, with a secret for each endpoint.",
    "categories": ["connector"],
    "links": [{ "title": "Repository", "url": "https://github.com/ahpio/ahpd" }],
    "icons": [
      { "src": "./icon.svg", "theme": "light" },
      { "src": "./icon-dark.svg", "theme": "dark" }
    ],
    "contracts": {
      "routes": ["post /plugins/webhook/:endpoint"],
      "triggerTypes": ["webhook"],
      "adapters": ["webhook"],
      "closers": ["the callback attempts still to come"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "syncTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How long a sync call waits for the turn to finish, in seconds. Defaults to 60. Each endpoint can override it."
        },
        "maxBodyBytes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Largest request body accepted, in bytes. Defaults to 5242880 (5 MiB). Larger bodies get 413."
        },
        "threadSessions": {
          "type": "boolean",
          "description": "How a bot endpoint's caller threads talk to the bot. false (default) is one session with the bot, and a chat of it for each thread; true is a session of its own for each thread."
        }
      }
    }
  }
}
