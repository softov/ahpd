{
  "name": "@ahpd/activepieces",
  "version": "0.14.0",
  "type": "module",
  "description": "Activepieces pieces as connectors for the ahpd daemon: each piece is an adapter, each action a host tool",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "connector",
    "activepieces"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/activepieces#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/activepieces"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/activepieces/test"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "dependencies": {
    "@activepieces/piece-airtable": "0.9.2",
    "@activepieces/piece-discord": "0.8.0",
    "@activepieces/piece-github": "0.11.0",
    "@activepieces/piece-hubspot": "0.13.1",
    "@activepieces/piece-jira-cloud": "0.6.1",
    "@activepieces/piece-linear": "0.9.1",
    "@activepieces/piece-notion": "0.8.1",
    "@activepieces/piece-resend": "0.6.1",
    "@activepieces/piece-sendgrid": "0.6.3",
    "@activepieces/piece-slack": "0.23.1",
    "@activepieces/piece-smtp": "0.5.0",
    "@activepieces/piece-stripe": "0.9.0",
    "@activepieces/piece-telegram-bot": "0.9.1",
    "@activepieces/piece-whatsapp": "1.0.1",
    "dayjs": "1.11.9",
    "ipaddr.js": "2.3.0"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Activepieces connectors",
    "description": "Each installed Activepieces piece is an adapter, and each of its actions is a host tool.",
    "categories": ["connector"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [{ "src": "./icon.svg" }],
    "contracts": {
      "adapters": ["ap-*"],
      "closers": ["the child process that runs the pieces"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "pieces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@activepieces/piece-[a-z0-9][a-z0-9-]*(?:@[^@\\s]+)?$"
          },
          "description": "The package of each Activepieces piece this plugin offers, such as @activepieces/piece-resend. A version may follow the name, as in @activepieces/piece-postgres@0.5.1; the newest version is installed when none is written."
        },
        "networkMode": {
          "type": "string",
          "enum": ["STRICT", "UNRESTRICTED"],
          "default": "STRICT",
          "description": "Activepieces' AP_NETWORK_MODE for the engine: STRICT refuses every connection a piece makes to a private, loopback, link-local or multicast address, UNRESTRICTED makes none."
        },
        "ssrfAllowList": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Activepieces' AP_SSRF_ALLOW_LIST: addresses and CIDR ranges a piece may reach under STRICT, such as 10.0.0.5 or 10.0.0.0/8."
        },
        "sandboxPropagatedEnvVars": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "The variables of the daemon's environment the engine is given, by name, as Activepieces' AP_SANDBOX_PROPAGATED_ENV_VARS. None by default."
        }
      },
      "required": ["pieces"]
    }
  }
}
