{
  "name": "@ahpd/agent-cofold",
  "version": "0.7.0",
  "type": "module",
  "description": "An AHP backend over the cofold agent runtime: every model it can reach is a model inside one provider",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "backend",
    "adapter",
    "cofold",
    "openai",
    "openrouter",
    "ollama"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/agent-cofold"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p ."
  },
  "peerDependencies": {
    "@ahpd/sdk": "^0.7"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "dependencies": {
    "@cofold/agents": "^0.1.0",
    "@cofold/model-openai-compat": "^0.1.0",
    "@cofold/store-file": "^0.1.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Cofold"
  }
}
