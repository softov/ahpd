{
  "name": "@ahpd/agent-cofold",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An AHP backend over the cofold agent runtime: every model it can reach is a model inside one provider",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "tsc -p ."
  },
  "peerDependencies": {
    "@ahpd/sdk": "^0.6"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "dependencies": {
    "@cofold/agents": "^0.1.0",
    "@cofold/model-openai-compat": "^0.1.0",
    "@cofold/store-file": "^0.1.0"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "title": "Cofold"
  }
}
