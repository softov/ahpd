{
  "name": "@ahpd/agent-pi",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "Pi coding agent integration for the Agent Host Protocol. Run it in process as an ahpd plugin or use it directly with @ahpd/sdk.",
  "keywords": [
    "ahp",
    "ahpd",
    "agent-host-protocol",
    "ahpio",
    "ai-agent",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "agent-backend",
    "agent-sdk",
    "plugin"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/agent-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/agent-pi"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/agent-pi/test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Agent pi",
    "description": "Run the pi coding agent inside the daemon.",
    "categories": ["agent"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [{ "src": "./icon.svg" }],
    "contracts": {
      "engines": ["pi"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "description": "Default model for agents that don't set one, as 'provider/modelId'." },
        "projectTrust": {
          "type": "string",
          "enum": ["trust", "deny"],
          "description": "Whether pi loads a project's own extensions, skills and prompts. 'trust' (default) loads them in folders the host trusts; 'deny' never loads them. Each agent can override it."
        },
        "sessionDir": { "type": "string", "description": "Folder where pi keeps its sessions. Defaults to pi's own. Each agent can override it." }
      }
    }
  }
}
