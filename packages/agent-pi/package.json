{
  "name": "@ahpd/agent-pi",
  "version": "0.15.0-rc.1",
  "type": "module",
  "description": "A pi backend for ahpd: the pi coding agent, embedded in process and served over the Agent Host Protocol",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "plugin",
    "pi",
    "pi-coding-agent",
    "coding-agent"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/softov/ahpd/tree/main/packages/agent-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softov/ahpd.git",
    "directory": "packages/agent-pi"
  },
  "bugs": {
    "url": "https://github.com/softov/ahpd/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "i18n",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/agent-pi/test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "peerDependencies": {
    "@ahpd/sdk": ">=0.14 <1"
  },
  "devDependencies": {
    "@ahpd/sdk": "workspace:*"
  },
  "ahpd": {
    "entry": "./dist/index.js",
    "i18n": "i18n",
    "title": "Agent pi",
    "description": "Runs the Pi coding agent, embedded in process and served as an agent provider.",
    "categories": ["agent"],
    "links": [{ "title": "Repository", "url": "https://github.com/softov/ahpd" }],
    "icons": [{ "src": "./icon.svg" }],
    "contracts": {
      "engines": ["pi"]
    },
    "optionsSchema": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "description": "The model a record that names none runs on, as provider/modelId." },
        "projectTrust": {
          "type": "string",
          "enum": ["trust", "deny"],
          "description": "Whether a record that names none loads a project's own pi extensions, skills and prompts. trust by default."
        },
        "sessionDir": { "type": "string", "description": "The folder a record that names none keeps its pi sessions in. pi's own by default." }
      }
    }
  }
}
