{
  "name": "ahpd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An Agent Host Protocol daemon that runs Claude Code sessions, on Node, Bun or Deno - and the parts to build your own",
  "bin": {
    "ahpd": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/src/main.js",
    "dev": "bun --watch src/main.ts",
    "dev:node": "node --watch --import ./scripts/dev.mjs src/main.ts",
    "dev:echo": "bun --watch examples/echo/main.ts",
    "dev:echo:node": "node --watch --import ./scripts/dev.mjs examples/echo/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@microsoft/agent-host-protocol": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "optionalDependencies": {
    "ws": "^8.18.0"
  }
}
