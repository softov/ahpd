{
  "name": "ahpd-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An Agent Host Protocol daemon that runs Claude Code sessions, on Node, Bun or Deno - and the parts to build your own",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p packages/server && tsc -p packages/agent-claude && tsc -p packages/ahpd",
    "start": "node packages/ahpd/dist/main.js",
    "start:heap": "node --heapsnapshot-near-heap-limit=1 --max-old-space-size=4096 packages/ahpd/dist/main.js",
    "dev": "node --watch --conditions development --import ./scripts/dev.mjs packages/ahpd/src/main.ts",
    "dev:bun": "bun --watch --conditions development packages/ahpd/src/main.ts",
    "echo": "node --watch --conditions development --import ./scripts/dev.mjs examples/echo/main.ts",
    "echo:bun": "bun --watch --conditions development examples/echo/main.ts",
    "notes": "node --watch --conditions development --import ./scripts/dev.mjs examples/notes/main.ts",
    "notes:bun": "bun --watch --conditions development examples/notes/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tools/schema.mjs && vitest run",
    "schema": "node tools/schema.mjs",
    "wire": "node tools/validate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "@microsoft/agent-host-protocol": "^0.9.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "zod": "^4.4.3",
    "ws": "^8.18.0",
    "node-pty": "^1.1.0-beta40"
  },
  "engines": {
    "node": ">=22"
  }
}
