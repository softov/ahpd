node_modules
dist
*.tsbuildinfo

# Environment files hold secrets; only the example is tracked.
.env
.env.*
!.env.example

# The example backend writes here when you run `npm run notes`.
/notes

# Wire captures from scripts/tee.mjs.
/ahp-*.jsonl

# The capture `packages/sdk/test/wire.test.ts` writes on every run.
/packages/sdk/test/fixtures/wire.jsonl

# Generated from the protocol package by `npm run schema`.
/tools/ahp.strict.schema.json

# Local experiments, kept out of git for now.
/.scratch

# The documentation site that `pnpm docs:build` writes, and its cache.
/docs/.vitepress/dist
/docs/.vitepress/cache

# Packages a plugin installs with host.install, such as Activepieces pieces.
/packages/*/installed
